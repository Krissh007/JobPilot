# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model your free tier allows, e.g. gemini-2.5-flash-lite
GEMINI_MODEL=
# Optional: comma-separated models to switch to when GEMINI_MODEL's daily free quota is used up
GEMINI_FALLBACK_MODELS=
# Free-tier pacing for the token-bucket limiter (requests per minute)
GEMINI_RPM=8

# Optional overrides (defaults shown)
# DATABASE_URL=sqlite:///E:/JobPilot/data/jobpilot.db
# Master resume (.docx/.pdf/.md) used for scoring AND tailoring:
# RESUME_PATH=E:\Krishna BA Resume\Krishna_Maheswaram_AI_Business_Analyst_Resume_Naukri.docx

# MCP server for the Agent Hub (python -m jobpilot.mcp_server)
JOBPILOT_MCP_TOKEN=

# Agents (the MCP server, JARVIS) call JobPilot's API with this as a bearer token; the dashboard doesn't need it.
# 32+ characters, the same value in every place that uses it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JOBPILOT_API_TOKEN=
# Only while running the Vite dev server (npm run dev): set to 1 so the API accepts its origin.
# JOBPILOT_DEV=1
