# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model your free tier allows, e.g. the one in the legacy agent's settings.yaml
GEMINI_MODEL=
# Free-tier pacing for the token-bucket limiter (requests per minute)
GEMINI_RPM=8

# Optional overrides (defaults shown)
# DATABASE_URL=sqlite:///E:/JobPilot/data/jobpilot.db
# LEGACY_AGENT_DIR=E:\job_search_agent
# LEGACY_PYTHON=python
# RESUME_PATH=E:\job_search_agent\config\master_resume.md
