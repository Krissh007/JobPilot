# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model your free tier allows, e.g. gemini-2.5-flash-lite
GEMINI_MODEL=
# Optional: comma-separated models to switch to when GEMINI_MODEL's daily free quota is used up
GEMINI_FALLBACK_MODELS=
# Free-tier pacing for the token-bucket limiter (requests per minute)
GEMINI_RPM=8

# Optional overrides (defaults shown)
# DATABASE_URL=sqlite:///E:/JobPilot/data/jobpilot.db
# Master resume (.docx/.pdf/.md) used for scoring AND tailoring:
# RESUME_PATH=E:\Krishna BA Resume\Krishna_Maheswaram_AI_Business_Analyst_Resume_Naukri.docx
